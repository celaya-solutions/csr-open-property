{
  "name": "@clawnify/open-property",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,green \"vite\" \"tsx watch --env-file-if-exists=.env src/server/node.ts\"",
    "db:migrate": "wrangler d1 execute open-property-db --local --file=src/server/schema.sql",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=.env src/server/node.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "db:export": "tsx scripts/export-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "lucide-react": "^0.575.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "railway": "^3.11.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1"
}
